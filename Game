import pygame
import random
import sys

# Initialize Pygame
pygame.init()

# Set screen dimensions
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Car Racing Game")

# Colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 0, 0)
BLUE = (0, 0, 255)
GRAY = (128, 128, 128)

# Load images with fallback
car_img = None
try:
    car_img = pygame.image.load('car.png')
except (pygame.error, FileNotFoundError):
    pass

enemy_img = None
try:
    enemy_img = pygame.image.load('enemy_car.png')
except (pygame.error, FileNotFoundError):
    pass

# Car dimensions
car_width = 73
car_height = 144

# Car initial position
car_x = (SCREEN_WIDTH - car_width) // 2
car_y = SCREEN_HEIGHT - car_height - 20

# Enemy car initial position
enemy_width = 73
enemy_height = 144
enemy_x = random.randint(0, SCREEN_WIDTH - enemy_width)
enemy_y = -enemy_height

# Car speed
car_speed = 5

# Enemy car speed
enemy_speed = 7

# Initialize Fonts once outside main loop
font = pygame.font.SysFont(None, 40)
game_over_font = pygame.font.SysFont(None, 60)

# Score tracking
score = 0

clock = pygame.time.Clock()

def draw_car(x, y):
    if car_img:
        screen.blit(car_img, (x, y))
    else:
        pygame.draw.rect(screen, BLUE, (x, y, car_width, car_height))

def draw_enemy_car(x, y):
    if enemy_img:
        screen.blit(enemy_img, (x, y))
    else:
        pygame.draw.rect(screen, RED, (x, y, enemy_width, enemy_height))

def draw_score(score):
    score_text = font.render(f"Score: {score}", True, BLACK)
    screen.blit(score_text, (20, 20))

def game_over(final_score):
    screen.fill(WHITE)

    # Center "Game Over!" text
    go_text = game_over_font.render("Game Over!", True, RED)
    go_rect = go_text.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 40))
    screen.blit(go_text, go_rect)

    # Center final score text
    score_text = font.render(f"Final Score: {final_score}", True, BLACK)
    score_rect = score_text.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 40))
    screen.blit(score_text, score_rect)

    pygame.display.update()
    pygame.time.delay(2000)
    pygame.quit()
    sys.exit()

# Game Loop
running = True
collision_occurred = False

while running:
    screen.fill(WHITE)
    
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    keys = pygame.key.get_pressed()
    if keys[pygame.K_LEFT] and car_x > 0:
        car_x -= car_speed
    if keys[pygame.K_RIGHT] and car_x < SCREEN_WIDTH - car_width:
        car_x += car_speed

    enemy_y += enemy_speed
    if enemy_y > SCREEN_HEIGHT:
        enemy_x = random.randint(0, SCREEN_WIDTH - enemy_width)
        enemy_y = -enemy_height
        score += 1

    # Check collision
    if car_x < enemy_x + enemy_width and car_x + car_width > enemy_x and car_y < enemy_y + enemy_height and car_y + car_height > enemy_y:
        collision_occurred = True
        break

    draw_car(car_x, car_y)
    draw_enemy_car(enemy_x, enemy_y)
    draw_score(score)
    
    pygame.display.update()
    clock.tick(60)

if collision_occurred:
    game_over(score)

pygame.quit()
sys.exit()
