import pygame
import random
import sys

# Initialize Pygame
pygame.init()

# Set screen dimensions
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Car Racing Game")

# Colors
WHITE, BLACK, RED, BLUE = (255, 255, 255), (0, 0, 0), (255, 0, 0), (0, 0, 255)

# Load images
try:
    car_img = pygame.image.load('car.png')
    enemy_img = pygame.image.load('enemy_car.png')
except (pygame.error, FileNotFoundError):
    car_img = enemy_img = None

# Car dimensions
car_width = 73
car_height = 144

# Car initial position
car_x = (SCREEN_WIDTH - car_width) // 2
car_y = SCREEN_HEIGHT - car_height - 20

# Enemy car initial position
enemy_width = 73
enemy_height = 144
enemy_x = random.randint(0, SCREEN_WIDTH - enemy_width)
enemy_y = -enemy_height

# Car speed
car_speed = 5

# Enemy car speed
enemy_speed = 7

clock = pygame.time.Clock()
score, font = 0, pygame.font.SysFont(None, 35)

def draw_car(x, y):
    if car_img: screen.blit(car_img, (x, y))
    else: pygame.draw.rect(screen, BLUE, [x, y, car_width, car_height])

def draw_enemy_car(x, y):
    if enemy_img: screen.blit(enemy_img, (x, y))
    else: pygame.draw.rect(screen, RED, [x, y, enemy_width, enemy_height])

def game_over(score):
    screen.fill(WHITE)
    for i, t in enumerate([("Game Over!", RED, 75), (f"Final Score: {score}", BLACK, 50)]):
        text = pygame.font.SysFont(None, t[2]).render(t[0], True, t[1])
        screen.blit(text, text.get_rect(center=(SCREEN_WIDTH//2, SCREEN_HEIGHT//2 + (i*100-50))))
    pygame.display.update()
    pygame.time.delay(2000)
    pygame.quit()
    sys.exit()

# Game Loop
running = True
while running:
    screen.fill(WHITE)
    
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    keys = pygame.key.get_pressed()
    if keys[pygame.K_LEFT] and car_x > 0:
        car_x -= car_speed
    if keys[pygame.K_RIGHT] and car_x < SCREEN_WIDTH - car_width:
        car_x += car_speed

    enemy_y += enemy_speed
    if enemy_y > SCREEN_HEIGHT:
        enemy_x = random.randint(0, SCREEN_WIDTH - enemy_width)
        enemy_y, score = -enemy_height, score + 1

    if car_x < enemy_x + enemy_width and car_x + car_width > enemy_x and car_y < enemy_y + enemy_height and car_y + car_height > enemy_y:
        game_over(score)

    draw_car(car_x, car_y)
    draw_enemy_car(enemy_x, enemy_y)
    screen.blit(font.render(f"Score: {score}", True, BLACK), (10, 10))
    pygame.display.update()
    clock.tick(60)

pygame.quit()
sys.exit()
