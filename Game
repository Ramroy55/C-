import pygame
import random
import sys

# Initialize Pygame
pygame.init()

# Set screen dimensions
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Car Racing Game")

# Colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 0, 0)
BLUE = (0, 0, 255)
GRAY = (200, 200, 200)

# Car dimensions
car_width = 73
car_height = 144

# Enemy dimensions
enemy_width = 73
enemy_height = 144

# Load images with fallback
try:
    car_img = pygame.image.load('car.png')
except (pygame.error, FileNotFoundError):
    car_img = None

try:
    enemy_img = pygame.image.load('enemy_car.png')
except (pygame.error, FileNotFoundError):
    enemy_img = None

# Car initial position
car_x = (SCREEN_WIDTH - car_width) // 2
car_y = SCREEN_HEIGHT - car_height - 20

# Enemy car initial position
enemy_x = random.randint(0, SCREEN_WIDTH - enemy_width)
enemy_y = -enemy_height

# Car speed
car_speed = 5

# Enemy car speed
enemy_speed = 7

# Fonts (initialized once outside the loop)
font_large = pygame.font.SysFont(None, 60)
font_medium = pygame.font.SysFont(None, 40)
font_small = pygame.font.SysFont(None, 30)

clock = pygame.time.Clock()

# Score tracking
score = 0

def draw_car(x, y):
    if car_img is not None:
        screen.blit(car_img, (x, y))
    else:
        pygame.draw.rect(screen, BLUE, (x, y, car_width, car_height))

def draw_enemy_car(x, y):
    if enemy_img is not None:
        screen.blit(enemy_img, (x, y))
    else:
        pygame.draw.rect(screen, RED, (x, y, enemy_width, enemy_height))

def draw_score(current_score):
    score_text = font_medium.render(f"Score: {current_score}", True, BLACK)
    screen.blit(score_text, (20, 20))

def game_over(final_score):
    # Centered game over card
    game_over_text = font_large.render("GAME OVER", True, RED)
    score_text = font_medium.render(f"Final Score: {final_score}", True, BLACK)
    restart_text = font_small.render("Closing game...", True, GRAY)

    # Use get_rect for perfect centering
    game_over_rect = game_over_text.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 50))
    score_rect = score_text.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 10))
    restart_rect = restart_text.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 70))

    screen.blit(game_over_text, game_over_rect)
    screen.blit(score_text, score_rect)
    screen.blit(restart_text, restart_rect)

    pygame.display.update()
    pygame.time.delay(2000)
    pygame.quit()
    sys.exit()

# Game Loop
running = True
while running:
    screen.fill(WHITE)
    
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    keys = pygame.key.get_pressed()
    if keys[pygame.K_LEFT] and car_x > 0:
        car_x -= car_speed
    if keys[pygame.K_RIGHT] and car_x < SCREEN_WIDTH - car_width:
        car_x += car_speed

    enemy_y += enemy_speed
    if enemy_y > SCREEN_HEIGHT:
        enemy_x = random.randint(0, SCREEN_WIDTH - enemy_width)
        enemy_y = -enemy_height
        score += 1

    if car_x < enemy_x + enemy_width and car_x + car_width > enemy_x and car_y < enemy_y + enemy_height and car_y + car_height > enemy_y:
        game_over(score)
        break

    draw_car(car_x, car_y)
    draw_enemy_car(enemy_x, enemy_y)
    draw_score(score)
    
    pygame.display.update()
    clock.tick(60)

pygame.quit()
sys.exit()
