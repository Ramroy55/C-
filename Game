import pygame
import random
import sys
import os

# Initialize Pygame
pygame.init()

# Set screen dimensions
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Car Racing Game")

# Colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 0, 0)

# Car dimensions
car_width = 73
car_height = 144

def load_image(name, width, height, color):
    try:
        if os.path.exists(name):
            return pygame.image.load(name)
    except pygame.error:
        pass

    # Create a placeholder surface if image is missing or fails to load
    surface = pygame.Surface((width, height))
    surface.fill(color)
    # Draw some "headlights" to indicate direction
    pygame.draw.rect(surface, (255, 255, 0), (5, 5, 15, 10))
    pygame.draw.rect(surface, (255, 255, 0), (width - 20, 5, 15, 10))
    return surface

# Load images
car_img = load_image('car.png', car_width, car_height, (0, 0, 255))
enemy_img = load_image('enemy_car.png', car_width, car_height, (255, 0, 0))

# Car initial position
car_x = (SCREEN_WIDTH - car_width) // 2
car_y = SCREEN_HEIGHT - car_height - 20

# Enemy car initial position
enemy_width = 73
enemy_height = 144
enemy_x = random.randint(0, SCREEN_WIDTH - enemy_width)
enemy_y = -enemy_height

# Car speed
car_speed = 5

# Enemy car speed
enemy_speed = 7

# Score
score = 0

clock = pygame.time.Clock()

# Fonts
score_font = pygame.font.SysFont(None, 25)
game_over_font = pygame.font.SysFont(None, 50)

def draw_car(x, y):
    screen.blit(car_img, (x, y))

def draw_enemy_car(x, y):
    screen.blit(enemy_img, (x, y))

def display_score(score):
    text = score_font.render(f"Score: {score}", True, BLACK)
    screen.blit(text, (10, 10))

def game_over(score):
    text = game_over_font.render("Game Over!", True, RED)
    score_text = game_over_font.render(f"Final Score: {score}", True, BLACK)

    # Center the text
    text_rect = text.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 25))
    score_rect = score_text.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 25))

    screen.blit(text, text_rect)
    screen.blit(score_text, score_rect)
    pygame.display.update()
    pygame.time.delay(2000)
    pygame.quit()
    sys.exit()

def main():
    global car_x, car_y, enemy_x, enemy_y, score
    # Game Loop
    running = True
    while running:
        screen.fill(WHITE)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT] and car_x > 0:
            car_x -= car_speed
        if keys[pygame.K_RIGHT] and car_x < SCREEN_WIDTH - car_width:
            car_x += car_speed

        enemy_y += enemy_speed
        if enemy_y > SCREEN_HEIGHT:
            enemy_x = random.randint(0, SCREEN_WIDTH - enemy_width)
            enemy_y = -enemy_height
            score += 1

        if car_x < enemy_x + enemy_width and car_x + car_width > enemy_x and car_y < enemy_y + enemy_height and car_y + car_height > enemy_y:
            game_over(score)

        draw_car(car_x, car_y)
        draw_enemy_car(enemy_x, enemy_y)
        display_score(score)

        pygame.display.update()
        clock.tick(60)

    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main()
