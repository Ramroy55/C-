import pygame
import random
import sys

def load_image(name, color):
    try:
        return pygame.transform.scale(pygame.image.load(name), (73, 144))
    except (pygame.error, FileNotFoundError):
        surf = pygame.Surface((73, 144))
        surf.fill(color)
        return surf

def main():
    pygame.init()
    screen = pygame.display.set_mode((800, 600))
    pygame.display.set_caption("Car Racing Game")

    font_score = pygame.font.SysFont(None, 35)
    font_gameover = pygame.font.SysFont(None, 50)

    car_img = load_image('car.png', (0, 255, 0))
    enemy_img = load_image('enemy_car.png', (255, 0, 0))

    car_x, car_y = 363, 436
    enemy_x, enemy_y = random.randint(0, 727), -144
    score = 0
    clock = pygame.time.Clock()

    while True:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit(); sys.exit()

        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT] and car_x > 0: car_x -= 5
        if keys[pygame.K_RIGHT] and car_x < 727: car_x += 5

        enemy_y += 7
        if enemy_y > 600:
            enemy_x, enemy_y = random.randint(0, 727), -144
            score += 1

        if pygame.Rect(car_x, car_y, 73, 144).colliderect(pygame.Rect(enemy_x, enemy_y, 73, 144)):
            msg = font_gameover.render(f"Game Over! Score: {score}", True, (255, 0, 0))
            screen.blit(msg, (250, 250))
            pygame.display.update(); pygame.time.delay(2000); break

        screen.fill((255, 255, 255))
        screen.blit(car_img, (car_x, car_y))
        screen.blit(enemy_img, (enemy_x, enemy_y))
        screen.blit(font_score.render(f"Score: {score}", True, (0, 0, 0)), (10, 10))
        pygame.display.update()
        clock.tick(60)
    pygame.quit()

if __name__ == "__main__":
    main()
