import pygame
import random
import sys

# Initialize Pygame
pygame.init()

# Set screen dimensions
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Car Racing Game")

# Car dimensions
car_width = 73
car_height = 144

# Colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 0, 0)
BLUE = (0, 0, 255)
GREEN = (0, 255, 0)

# Load images with fallback
def load_image(filename, width, height, color):
    try:
        img = pygame.image.load(filename)
        return pygame.transform.scale(img, (width, height))
    except (pygame.error, FileNotFoundError):
        fallback = pygame.Surface((width, height))
        fallback.fill(color)
        return fallback

car_img = load_image('car.png', car_width, car_height, BLUE)
enemy_img = load_image('enemy_car.png', car_width, car_height, RED)

# Car initial position
car_x = (SCREEN_WIDTH - car_width) // 2
car_y = SCREEN_HEIGHT - car_height - 20

# Enemy car initial position
enemy_width = 73
enemy_height = 144
enemy_x = random.randint(0, SCREEN_WIDTH - enemy_width)
enemy_y = -enemy_height

# Car speed
car_speed = 5

# Enemy car speed
enemy_speed = 7

# Score
score = 0
font = pygame.font.SysFont(None, 35)

clock = pygame.time.Clock()

def display_score(score):
    score_text = font.render(f"Score: {score}", True, BLACK)
    screen.blit(score_text, (10, 10))

def draw_car(x, y):
    screen.blit(car_img, (x, y))

def draw_enemy_car(x, y):
    screen.blit(enemy_img, (x, y))

def game_over(final_score):
    over_font = pygame.font.SysFont(None, 75)
    over_text = over_font.render("Game Over!", True, RED)
    over_rect = over_text.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 50))

    score_font = pygame.font.SysFont(None, 50)
    score_text = score_font.render(f"Final Score: {final_score}", True, BLACK)
    score_rect = score_text.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 50))

    screen.fill(WHITE)
    screen.blit(over_text, over_rect)
    screen.blit(score_text, score_rect)
    pygame.display.update()
    pygame.time.delay(3000)
    pygame.quit()
    sys.exit()

# Game Loop
running = True
while running:
    screen.fill(WHITE)
    
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    keys = pygame.key.get_pressed()
    if keys[pygame.K_LEFT] and car_x > 0:
        car_x -= car_speed
    if keys[pygame.K_RIGHT] and car_x < SCREEN_WIDTH - car_width:
        car_x += car_speed

    enemy_y += enemy_speed
    if enemy_y > SCREEN_HEIGHT:
        enemy_x = random.randint(0, SCREEN_WIDTH - enemy_width)
        enemy_y = -enemy_height
        score += 1

    if car_x < enemy_x + enemy_width and car_x + car_width > enemy_x and car_y < enemy_y + enemy_height and car_y + car_height > enemy_y:
        game_over(score)

    draw_car(car_x, car_y)
    draw_enemy_car(enemy_x, enemy_y)
    display_score(score)
    
    pygame.display.update()
    clock.tick(60)

pygame.quit()
sys.exit()
