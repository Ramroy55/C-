import pygame
import random
import sys

# Initialize Pygame
pygame.init()

# Set screen dimensions
SCREEN_WIDTH = 800
SCREEN_HEIGHT = 600
screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
pygame.display.set_caption("Car Racing Game")

# Colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 0, 0)
BLUE = (0, 0, 255)
GRAY = (200, 200, 200)

# Car dimensions
car_width = 73
car_height = 144

# Enemy dimensions
enemy_width = 73
enemy_height = 144

# Load images with robust fallback handling
try:
    car_img = pygame.image.load('car.png')
except (pygame.error, FileNotFoundError):
    car_img = None

try:
    enemy_img = pygame.image.load('enemy_car.png')
except (pygame.error, FileNotFoundError):
    enemy_img = None

# Car initial position
car_x = (SCREEN_WIDTH - car_width) // 2
car_y = SCREEN_HEIGHT - car_height - 20

# Enemy car initial position
enemy_x = random.randint(0, SCREEN_WIDTH - enemy_width)
enemy_y = -enemy_height

# Car speed
car_speed = 5

# Enemy car speed
enemy_speed = 7

# Score tracking
score = 0

# Initialize fonts once outside the main game loop
font_score = pygame.font.SysFont(None, 36)
font_game_over = pygame.font.SysFont(None, 50)
font_final_score = pygame.font.SysFont(None, 40)

clock = pygame.time.Clock()

def draw_car(x, y):
    if car_img:
        screen.blit(car_img, (x, y))
    else:
        pygame.draw.rect(screen, BLUE, (x, y, car_width, car_height))

def draw_enemy_car(x, y):
    if enemy_img:
        screen.blit(enemy_img, (x, y))
    else:
        pygame.draw.rect(screen, RED, (x, y, enemy_width, enemy_height))

def draw_score(score):
    score_text = font_score.render(f"Score: {score}", True, BLACK)
    screen.blit(score_text, (10, 10))

def game_over(final_score):
    screen.fill(WHITE)

    # Render "Game Over!" text centered
    text_game_over = font_game_over.render("Game Over!", True, RED)
    rect_game_over = text_game_over.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 30))
    screen.blit(text_game_over, rect_game_over)

    # Render final score centered below
    text_final_score = font_final_score.render(f"Final Score: {final_score}", True, BLACK)
    rect_final_score = text_final_score.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 30))
    screen.blit(text_final_score, rect_final_score)

    pygame.display.update()
    pygame.time.delay(2000)
    pygame.quit()
    sys.exit()

# Game Loop
running = True
collision_occurred = False

while running:
    screen.fill(WHITE)
    
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    keys = pygame.key.get_pressed()
    if keys[pygame.K_LEFT] and car_x > 0:
        car_x -= car_speed
    if keys[pygame.K_RIGHT] and car_x < SCREEN_WIDTH - car_width:
        car_x += car_speed

    enemy_y += enemy_speed
    if enemy_y > SCREEN_HEIGHT:
        enemy_x = random.randint(0, SCREEN_WIDTH - enemy_width)
        enemy_y = -enemy_height
        score += 1

    if car_x < enemy_x + enemy_width and car_x + car_width > enemy_x and car_y < enemy_y + enemy_height and car_y + car_height > enemy_y:
        collision_occurred = True
        break

    draw_car(car_x, car_y)
    draw_enemy_car(enemy_x, enemy_y)
    draw_score(score)
    
    pygame.display.update()
    clock.tick(60)

if collision_occurred:
    game_over(score)

pygame.quit()
sys.exit()
